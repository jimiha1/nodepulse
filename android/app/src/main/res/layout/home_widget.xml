<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header: Server Name, Ping/Status dot, Time and Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widgetText"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Server Name" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/widgetSummaryText"
            android:textSize="11sp"
            tools:text="14:20" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/widget_refresh_desc"
            android:padding="4dp"
            android:src="@drawable/refresh_24" />
    </LinearLayout>

    <!-- Error message fallback -->
    <TextView
        android:id="@+id/error_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widgetSummaryText"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Tap to configure" />

    <!-- 2x2 Charts Grid container (supporting 1, 2, or 4 charts) -->
    <LinearLayout
        android:id="@+id/widget_charts_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Chart Row 1 -->
        <LinearLayout
            android:id="@+id/widget_chart_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_chart_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/widget_chart_desc"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_chart_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/widget_chart_desc"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Chart Row 2 -->
        <LinearLayout
            android:id="@+id/widget_chart_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_chart_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/widget_chart_desc"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_chart_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/widget_chart_desc"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <!-- Readings container with up to 4 rows x 2 columns = 8 capsule cells -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Row 1: Cell 1 & Cell 2 -->
        <LinearLayout
            android:id="@+id/widget_cell_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Cell 1 -->
            <LinearLayout
                android:id="@+id/widget_cell_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_capsule_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_cell_1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widgetSummaryText"
                    android:textSize="10sp"
                    tools:text="CPU" />

                <TextView
                    android:id="@+id/widget_cell_1_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/widgetText"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="6.5%" />
            </LinearLayout>

            <!-- Cell 2 -->
            <LinearLayout
                android:id="@+id/widget_cell_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_capsule_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_cell_2_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widgetSummaryText"
                    android:textSize="10sp"
                    tools:text="负载" />

                <TextView
                    android:id="@+id/widget_cell_2_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/widgetText"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="0.04" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Cell 3 & Cell 4 -->
        <LinearLayout
            android:id="@+id/widget_cell_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Cell 3 -->
            <LinearLayout
                android:id="@+id/widget_cell_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_capsule_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_cell_3_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widgetSummaryText"
                    android:textSize="10sp"
                    tools:text="内存" />

                <TextView
                    android:id="@+id/widget_cell_3_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/widgetText"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="42%" />
            </LinearLayout>

            <!-- Cell 4 -->
            <LinearLayout
                android:id="@+id/widget_cell_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_capsule_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_cell_4_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widgetSummaryText"
                    android:textSize="10sp"
                    tools:text="速率" />

                <TextView
                    android:id="@+id/widget_cell_4_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/widgetText"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="↑10K ↓12K" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 3: Cell 5 & Cell 6 -->
        <LinearLayout
            android:id="@+id/widget_cell_row_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Cell 5 -->
            <LinearLayout
                android:id="@+id/widget_cell_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_capsule_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_cell_5_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widgetSummaryText"
                    android:textSize="10sp"
                    tools:text="磁盘" />

                <TextView
                    android:id="@+id/widget_cell_5_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/widgetText"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="55%" />
            </LinearLayout>

            <!-- Cell 6 -->
            <LinearLayout
                android:id="@+id/widget_cell_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_capsule_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_cell_6_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widgetSummaryText"
                    android:textSize="10sp"
                    tools:text="剩余流量" />

                <TextView
                    android:id="@+id/widget_cell_6_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/widgetText"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="9.8 TB" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 4: Cell 7 & Cell 8 -->
        <LinearLayout
            android:id="@+id/widget_cell_row_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Cell 7 -->
            <LinearLayout
                android:id="@+id/widget_cell_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_capsule_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_cell_7_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widgetSummaryText"
                    android:textSize="10sp"
                    tools:text="连接" />

                <TextView
                    android:id="@+id/widget_cell_7_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/widgetText"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="T:27 U:7" />
            </LinearLayout>

            <!-- Cell 8 -->
            <LinearLayout
                android:id="@+id/widget_cell_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_capsule_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_cell_8_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widgetSummaryText"
                    android:textSize="10sp"
                    tools:text="延迟" />

                <TextView
                    android:id="@+id/widget_cell_8_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/widgetText"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="电134 联101 移299" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
